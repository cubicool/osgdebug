@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenSceneGraph REQUIRED COMPONENTS
	osg
	osgDB
	osgGA
	osgViewer
	osgUtil
	osgFX
	osgText
	osgWidget
	osgAnimation
)
find_dependency(OpenGL REQUIRED)

# libosgx PRIVATE-links PkgConfig::X11 unconditionally (osgx::platform's Linux.cpp is a hard
# dependency, not opt-in -- see the matching pkg_check_modules() call in the top-level
# CMakeLists.txt). A STATIC osgx therefore needs this imported target to exist here too, since
# osgxTargets.cmake bakes PRIVATE link dependencies into the exported target's link interface.
find_dependency(PkgConfig REQUIRED)
pkg_check_modules(X11 REQUIRED IMPORTED_TARGET x11 xrandr)

if(@OSGX_BUILD_KTX2@)
	find_dependency(Ktx CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/osgxTargets.cmake")

# CMake's FindOpenSceneGraph module does not provide imported targets. Attach
# the libraries it discovers to the installed core target here so the exported
# package remains relocatable instead of recording this machine's library paths.
set_property(TARGET osgx::core APPEND PROPERTY
	INTERFACE_INCLUDE_DIRECTORIES "${OPENSCENEGRAPH_INCLUDE_DIRS}"
)
# OPENSCENEGRAPH_LIBRARIES may contain target_link_libraries() configuration
# selectors such as "optimized" and "debug". Pass it through that command so
# the selectors become configuration generator expressions rather than literal
# library names ("-loptimized"/"-ldebug") in downstream link commands.
target_link_libraries(osgx::core INTERFACE ${OPENSCENEGRAPH_LIBRARIES})

check_required_components(osgx)
